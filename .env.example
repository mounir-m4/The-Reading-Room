# ---------------------------------------------------------------------------
# Copy to .env (root and/or server/.env). Never commit real secrets.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# On Netlify/Render this can be omitted: the server uses URL/RENDER_EXTERNAL_URL automatically.

# MongoDB (local or Atlas).
MONGO_URI=mongodb://127.0.0.1:27017/the_reading_room
# For tests, mongodb-memory-server is used automatically when USE_MEMORY_DB=true
USE_MEMORY_DB=false

# Access/refresh tokens — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudinary (optional in development; local disk storage fallback is automatic)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (optional; console transport fallback in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="The Reading Room <hello@thereadingroom.test>"

# Stripe (optional; mock payment method enabled in development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Exchange rates (optional; static fallback rates are used when unset)
EXCHANGE_RATE_PROVIDER=static
EXCHANGE_RATE_API_KEY=

# Initial administrator created by the seed script
SEED_ADMIN_EMAIL=admin@bookstore.test
SEED_ADMIN_PASSWORD=Admin@12345
