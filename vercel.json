{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build --workspace client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__vercel_api_path=:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index?__vercel_page=robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?__vercel_page=sitemap.xml"
    },
    {
      "source": "/:path((?!api/|api$|assets/|robots\\.txt$|sitemap\\.xml$).*)",
      "destination": "/index.html"
    }
  ]
}
