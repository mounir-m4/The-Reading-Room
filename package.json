{
  "name": "the-reading-room",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "The Reading Room — full-stack MERN bookstore",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "seed:demo": "npm run seed:demo --workspace server",
    "test": "npm run test --workspace server && npm run test --workspace client",
    "lint": "npm run lint --workspace server && npm run lint --workspace client",
    "format": "prettier --write \"{client,server}/**/*.{js,jsx,json,css,md}\""
  },
  "devDependencies": {
    "concurrently": "9.0.1",
    "prettier": "3.3.3"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "mongodb-memory-server@10.1.2": true,
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "serverless-http": "^4.0.0"
  }
}
